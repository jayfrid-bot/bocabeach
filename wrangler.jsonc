{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isitbeachday",
  // worker.ts wraps OpenNext's generated .open-next/worker.js: the agent paths get a Content-Length
  // instead of a chunked stream (lib/workerWrap.ts). It re-exports everything the generated worker exports.
  "main": "worker.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "PUSH_KV", "id": "4dab9a763f5c416ab8c97ff19f47cf40" },
    // OpenNext incremental cache (ISR + unstable_cache) — backs the cached
    // conditions pipeline so the worker doesn't re-run the full 18-source fetch
    // + 192-hour scoring on every request (that ran it over its resource limit
    // → 1102 under load). Reuses the same namespace; OpenNext prefixes its keys.
    { "binding": "NEXT_INC_CACHE_KV", "id": "4dab9a763f5c416ab8c97ff19f47cf40" }
  ],
  // Webcam archive: one still per cam per beach-local hour (lib/camFrames/,
  // docs/CAM_ARCHIVE_PLAN.md). Lifecycle rule deletes objects after 367 days
  // (set with `wrangler r2 bucket lifecycle add`, not here); D1 rows go at 365.
  "r2_buckets": [
    { "binding": "CAM_FRAMES", "bucket_name": "isitbeachday-cam-frames" }
  ],
  // Beach Day Plus store: devices, presence, alert dedup (see migrations/).
  // Apply schema changes with `wrangler d1 migrations apply isitbeachday-plus --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "isitbeachday-plus",
      "database_id": "0ee25fbd-fc05-4c5c-a8ae-9e0c8d4c1bb0",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI: Cloudflare's Clef 27B (@cf/cloudflare/clef) is the cam reader's
  // fallback vision model, called by POST /api/vision/clef (lib/vision/,
  // docs/benchmarks/clef-vision-2026-10-12/). The route counts calls per UTC
  // day in D1 (vision_daily_calls, migrations/0018) and stops at 600
  // (lib/vision/dailyCap.ts). No new secret.
  "ai": { "binding": "AI" },
  // Public agent surface (lib/agent/rateLimit.ts): per-IP limits with the Workers Rate
  // Limiting binding, two separate budgets. REST (/api/v1/*) 60 per 60 s per IP; MCP (/mcp)
  // 300 per 60 s per IP (hosted connectors share egress IPs). Counters are per Cloudflare
  // location and eventually consistent: a brake, not a hard ceiling. namespace_id must be
  // UNIQUE across the whole Cloudflare account (4721/4722 were picked for this app; check no
  // other Worker uses them). `period` can only be 10 or 60. If a binding is missing the code
  // falls back to a per-isolate token bucket.
  "ratelimits": [
    { "name": "AGENT_RATE_LIMITER", "namespace_id": "4721", "simple": { "limit": 60, "period": 60 } },
    { "name": "AGENT_MCP_RATE_LIMITER", "namespace_id": "4722", "simple": { "limit": 300, "period": 60 } }
  ],
  // Hazard alerts are LIVE. They were paused while they fired off a person's HOME
  // beach (lightning 5 mi from a beach you're nowhere near is noise); they now fire
  // only from a live presence fix — see lib/alerts/*. Set this to "off" to stop
  // every hazard alert app-wide without a deploy of the engine.
  //
  // Sunrise/sunset color push alerts are OFF until the satellite observation input
  // ships (owner, 2026-10-15; docs/benchmarks/sun-leadtime-2026-10-15/REPORT.md). Set
  // SUN_ALERTS_ENABLED to "on" to turn them back on. Missing = off. Only the push is
  // gated: the sun card and its "forecast at ..." line stay on in the app.
  // The app's copy about the alert follows NEXT_PUBLIC_SUN_ALERTS, a BUILD-time variable
  // (lib/plus/flags.ts): set it to "on" together with SUN_ALERTS_ENABLED, then redeploy.
  "vars": {
    "PUSH_SAFETY_ALERTS": "on",
    "SUN_ALERTS_ENABLED": "off"
  }
  // Data-quality loop (docs/QUALITY_PLAN.md, migrations/0019). Secrets, set with `wrangler secret put`:
  //   OWNER_ENROLL_CODE     the one-time code a phone uses to become the owner: open
  //                         /admin/review#enroll=<code> once. The server keeps only a SHA-256 of
  //                         the token it hands back (owner_sessions). Unset = nobody can enroll.
  //   QUALITY_INGEST_TOKEN  the cam reader's credential for /api/quality/alerts and
  //                         /api/quality/overrides. Also a GitHub Actions secret (sargassum.yml).
  //                         Separate from INGEST_TOKEN.
  // Owner pushes (APNs, iPhone) go only to the push token stored on an owner session, and are sent
  // by /api/quality/drain, which workers/history-cron calls every minute with CRON_SECRET.
  // NOTE: custom domains (isitbeachday.com, www, app.isitbeachday.com) are attached
  // to this Worker via the Cloudflare API/dashboard, deliberately NOT via a `routes`
  // array here — a routes array risks reconciling-away the dashboard-managed domains
  // on deploy. Push secrets (APNs/FCM/CRON_SECRET/AIRNOW) are set with `wrangler secret`.
}
