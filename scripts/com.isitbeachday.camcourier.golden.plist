<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  GOLDEN-HOUR companion to com.isitbeachday.camcourier.plist (the routine job). Same
  script, launched with the golden-only flag. It grabs a cam while ITS OWN beach is inside a
  sunrise (-20/+40 min) or sunset (-40/+20 min) window, matching the webcam archive's
  10-minute golden slots. With many cams in a window at once the scheduler widens the
  stride to 20 or 30 minutes so the yt-dlp call budget holds. See
  scripts/cam_courier_local.sh and docs/courier-pacing.md.

  Fires every 10 minutes, ALL day (:00, :10, ... :50). It used to list the local hours of
  the four original beaches' windows; a new beach (Georgia, Carolinas, Texas, a summer
  sunrise at 05:30) would have fallen outside that list. The scheduler asks the sun, so no
  hour list is needed. A fire outside every window costs about 0.2 s and logs nothing.

  The script takes a run lock, so a golden run that meets a still-running routine run
  just skips; the next fire is 10 minutes away.

  To install (replace __HOME__ first):
    sed "s#__HOME__#$HOME#g" scripts/com.isitbeachday.camcourier.golden.plist \
      > "$HOME/Library/LaunchAgents/com.isitbeachday.camcourier.golden.plist"
    launchctl bootstrap gui/$(id -u) \
      "$HOME/Library/LaunchAgents/com.isitbeachday.camcourier.golden.plist"

  To uninstall:
    launchctl bootout gui/$(id -u)/com.isitbeachday.camcourier.golden
    rm "$HOME/Library/LaunchAgents/com.isitbeachday.camcourier.golden.plist"

  To check status / force a run:
    launchctl print gui/$(id -u)/com.isitbeachday.camcourier.golden
    launchctl kickstart -k gui/$(id -u)/com.isitbeachday.camcourier.golden
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.isitbeachday.camcourier.golden</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/Projects/bocabeach/scripts/cam_courier_local.sh</string>
    <string>--golden-only</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/Projects/bocabeach</string>

  <!-- Every 10 minutes, all day (6 entries). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>10</integer></dict>
    <dict><key>Minute</key><integer>20</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>40</integer></dict>
    <dict><key>Minute</key><integer>50</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/cam-courier.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/cam-courier.log</string>
</dict>
</plist>
