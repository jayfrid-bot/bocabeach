<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ROUTINE launchd job for scripts/cam_courier_local.sh — see that script's header
  for the token-file setup and what this job does.

  Every 5 minutes, at :03, :08, ... :58. Each run asks scripts/courier_schedule.py which
  cams are due (a cam whose last good frame is 57+ minutes old; a few cams per run, most
  overdue first), so the cams spread over the hour instead of all firing at :07. Most
  runs find nothing due and exit at once without a log line. The daylight gate
  (06:00-20:59 America/New_York) is inside the scheduler.

  Its golden-hour companion (every 10 minutes, golden-only flag) is
  scripts/com.isitbeachday.camcourier.golden.plist. Install both. launchd cannot pass
  different arguments per calendar entry, so they are two jobs. Both go through the
  shared yt-dlp pacer (scripts/yt_pacer.py); see docs/courier-pacing.md.

  To install (replace __HOME__ first):
    sed "s#__HOME__#$HOME#g" scripts/com.isitbeachday.camcourier.plist \
      > "$HOME/Library/LaunchAgents/com.isitbeachday.camcourier.plist"
    launchctl bootstrap gui/$(id -u) \
      "$HOME/Library/LaunchAgents/com.isitbeachday.camcourier.plist"

  To replace an installed copy: launchctl bootout gui/$(id -u)/com.isitbeachday.camcourier
  first, then run the two commands above.

  To uninstall:
    launchctl bootout gui/$(id -u)/com.isitbeachday.camcourier
    rm "$HOME/Library/LaunchAgents/com.isitbeachday.camcourier.plist"

  To check status / force a run:
    launchctl print gui/$(id -u)/com.isitbeachday.camcourier
    launchctl kickstart -k gui/$(id -u)/com.isitbeachday.camcourier
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.isitbeachday.camcourier</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/Projects/bocabeach/scripts/cam_courier_local.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/Projects/bocabeach</string>

  <!-- Every hour at :03, :08, ... :58 (12 fires an hour, offset from the golden job's :00/:10/... fires). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>3</integer></dict>
    <dict><key>Minute</key><integer>8</integer></dict>
    <dict><key>Minute</key><integer>13</integer></dict>
    <dict><key>Minute</key><integer>18</integer></dict>
    <dict><key>Minute</key><integer>23</integer></dict>
    <dict><key>Minute</key><integer>28</integer></dict>
    <dict><key>Minute</key><integer>33</integer></dict>
    <dict><key>Minute</key><integer>38</integer></dict>
    <dict><key>Minute</key><integer>43</integer></dict>
    <dict><key>Minute</key><integer>48</integer></dict>
    <dict><key>Minute</key><integer>53</integer></dict>
    <dict><key>Minute</key><integer>58</integer></dict>
  </array>

  <!-- No RunAtLoad: a run at load would fire at the same instant as the golden job's
       load. The next calendar minute is at most 5 minutes away. -->

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/cam-courier.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/cam-courier.log</string>
</dict>
</plist>
